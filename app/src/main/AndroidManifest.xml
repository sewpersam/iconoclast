<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Installs each Apply's pack under a new name, then uninstalls the one before it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Only for "Paste image link": downloads the one image the user names. Nothing else uses the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <!-- The generated packs: each Apply installs one under a new name, so they are
             found by the icon pack action they all declare, not by a fixed package. -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <!-- Every icon pack action Neo Launcher lists packs by, to place the pack's icon in
             Neo's icon screen the way Neo orders it. -->
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="org.adw.launcher.icons.ACTION_PICK_ICON" /></intent>
        <intent><action android:name="com.anddoes.launcher.THEME" /></intent>
        <intent><action android:name="com.teslacoilsw.launcher.THEME" /></intent>
        <intent><action android:name="com.fede.launcher.THEME_ICONPACK" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
        <intent><action android:name="com.dlto.atom.launcher.THEME" /></intent>
        <!-- Neo Launcher's icon screen, opened per app to point its custom icon at the pack. -->
        <package android:name="com.saggitt.omega" />
        <!-- Coverage: every launchable app. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The current home app, for the guidance after Apply. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".IconoclastApp"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share an image here, from a browser or a gallery: it opens as a new image layer. -->
            <intent-filter android:label="Add to an icon theme">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!-- Points Neo Launcher custom icons at the pack: taps one icon in Neo's icon screen. -->
        <service
            android:name=".NeoIconService"
            android:exported="false"
            android:label="@string/neo_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/neo_icon_service" />
        </service>
        <!-- Theme export: the share sheet reads the JSON from cache/export. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
